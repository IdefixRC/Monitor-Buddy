#pragma once
// ============================================================
//  Monitor-Buddy — user configuration
// ------------------------------------------------------------
//  WHO NEEDS THIS FILE
//
//  Most people never touch it: tools/mb_serial.py (and the web flasher,
//  coming in a later release) can set everything below and save it on
//  the board. This file is for building from source. Its values are the
//  defaults, used for anything not saved on the board. Once settings are
//  saved on the board, those saved values win over this file.
//
//  HOW TO USE IT (source builds)
//
//  1. Copy this file to  config/config.h  (same folder).
//       - VS Code: right-click config.h.example > Copy, then Paste,
//         and rename the copy to  config.h
//  2. Open  config/config.h  and edit the values below.
//  3. config/config.h is gitignored and must never be committed —
//     it holds your private Finnhub API key. This template is the
//     only config file tracked by git.
//
//  If config/config.h is missing, the project still builds using
//  the default values in this template.
//
//  A few entries are worth setting:
//   Mount:   Left or right side of your monitor.
//   Github:  Your username, to show the GitHub page (empty hides it).
//   Time:    Set your IANA timezone name, and your UTC offset or a
//            TZ_RULE with daylight saving.
//   Stocks:  Set a US stock ticker and your free Finnhub API key
//            (register at https://finnhub.io); an empty key hides the page.
//   Weather: Set LAT/LONG to your location, pick temp/wind units.
//   Theme:   Pick one of the five colour themes.
//   Pages:   Toggle each page on/off.
// ============================================================

// ── Mounting location ───────────────────────────────────────
// Which side of the monitor your Buddy is mounted on. The printed holder
// works on either side; RIGHT turns the screen, touch and eye tilt by 180°
// so everything reads the right way up.
#define MOUNTING_LOCATION LEFT   // LEFT or RIGHT (capitals)

// ── Colour theme ────────────────────────────────────────────
//   0 = Classic   (white on black, the original look)
//   1 = Minimal   (white/gray with a single cyan accent on the key value)
//   2 = Semantic  (stock up=green/down=red, warm weather, gold sun & moon...)
//   3 = Warm amber (one gold/amber hue everywhere)
//   4 = Cool teal / blue
#define THEME 2

// ── GitHub ──────────────────────────────────────────────────
// Your GitHub username for the stats page. Leave "" to hide the page.
#define GITHUB_USER   ""

// ── Time ────────────────────────────────────────────────────
// TIMEZONE   IANA name — used for the weather request.
//            List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
// TZ_RULE    Optional POSIX rule for the clock, with daylight saving.
//            Examples: "CET-1CEST,M3.5.0,M10.5.0/3" = Central Europe,
//                      "EST5EDT,M3.2.0,M11.1.0" = US Eastern.
//            Leave "" to use TZ_OFFSET_HOURS (no daylight saving).
// TZ_OFFSET_HOURS  UTC offset in hours, used when TZ_RULE is "".
//            Examples: -5 = US Eastern, -8 = US Pacific, +1 = CET,
//                      +5.5 = IST, +8 = SGT
#define TIMEZONE        "Asia/Singapore"
#define TZ_RULE         ""
#define TZ_OFFSET_HOURS 8

// ── Stock market ────────────────────────────────────────────
// Quotes come from Finnhub (https://finnhub.io/).
// TICKER    US stock symbol (the free Finnhub tier is US only).
// STOCKKEY  Your free Finnhub API key from https://finnhub.io/register.
//           Leave "" to hide the stock page.
#define TICKER    "AAPL"
#define STOCKKEY  ""

// ── Weather ─────────────────────────────────────────────────
// LAT / LONG  Your location for weather queries.
// TEMP        Temperature unit — "celsius" or "fahrenheit".
// WIND        Wind speed unit — "kmh" or "mph".
#define LAT   "1.3119"
#define LONG  "103.8149"
#define TEMP  "celsius"
#define WIND  "kmh"

// ── Pages ───────────────────────────────────────────────────
// Toggle each page on (true) or off (false). Disabled pages are
// skipped when swiping and auto-scrolling, and never fetch data.
// Leave at least one on — if all are off, the Face page is forced
// back on so the screen is never blank.
#define SHOW_FACE     true   // animated expressive face
#define SHOW_CLOCK    true   // digital clock
#define SHOW_DATE     true   // weekday / date
#define SHOW_WEATHER  true   // current weather (needs Wi-Fi)
#define SHOW_MOON     true   // moon phase
#define SHOW_STOCK    true   // stock ticker (needs Wi-Fi + Finnhub key)
#define SHOW_GITHUB   true   // GitHub follower/repo stats (needs Wi-Fi)

// ── Build-only options ──────────────────────────────────────
// These are compiled in. The web flasher doesn't know about them, and
// settings it saved on the board don't change them.
//
// Clock: true shows 1-12 with AM/PM, false shows 00-23.
#define CLOCK_12H false

// Night mode: from NIGHT_START_HOUR to NIGHT_END_HOUR (local time, 0-23,
// may cross midnight) the backlight drops to NIGHT_BRIGHTNESS (8-255) and
// the face looks sleepy. A touch restores your brightness for 30 s; that
// touch only wakes the screen. Stays off until the clock has synced.
#define NIGHT_MODE       false
#define NIGHT_START_HOUR 23
#define NIGHT_END_HOUR   7
#define NIGHT_BRIGHTNESS 8

// Bitcoin page: BTC/USD from Coinbase's public market data (no key needed),
// with the 24 h change, high/low and a 24 h sparkline. Sits after the
// stock page.
#define SHOW_BITCOIN false

// Setup hotspot. The password (8-63 characters) is shown on the Buddy's
// screen while the hotspot is open, so a random one costs nothing.
// #define AP_SSID "Monitor-Buddy-Setup"
// #define AP_PASS "buddy1234"
